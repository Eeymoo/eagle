{
  "name": "@eagle/core",
  "version": "0.1.0",
  "description": "Eagle live-TV core — platform-agnostic business core for Jellyfin / M3U Tuner / HDHomeRun sources",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf lib *.tsbuildinfo",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile:check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^5.0.10",
    "typescript": "~5.8.2",
    "vitest": "3.2.4"
  },
  "react-native": "./src/index.ts"
}