{
  "name": "eagle-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "core": "pnpm --filter @eagle/core",
    "rn": "pnpm --filter @eagle/rn-ui-plugin",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm --filter @eagle/core build && pnpm --filter '@eagle/*-plugin' run build",
    "test": "pnpm --filter '@eagle/*' run test",
    "docs": "node scripts/print-tree.mjs"
  },
  "devDependencies": {
    "expo": "~54.0.37",
    "react-native": "0.81.4"
  },
  "dependencies": {
    "lucide-react": "0.460.0",
    "lucide-react-native": "0.460.0",
    "react-native-svg": "^15.15.5"
  }
}