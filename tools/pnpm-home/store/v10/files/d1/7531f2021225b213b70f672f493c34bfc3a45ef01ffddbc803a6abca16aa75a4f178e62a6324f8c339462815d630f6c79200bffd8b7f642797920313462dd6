{"version":3,"file":"reactNavigationImport.js","sourceRoot":"","sources":["../../src/js/reactNavigationImport.ts"],"names":[],"mappings":"AAIA,IAAI,OAAwD,CAAC;AAE7D;;;GAGG;AACH,MAAM,UAAU,+BAA+B;;IAC7C,IAAI,OAAO,KAAK,SAAS,EAAE,CAAC;QAC1B,OAAO,OAAO,CAAC;IACjB,CAAC;IACD,IAAI,CAAC;QACH,8DAA8D;QAC9D,MAAM,GAAG,GAAG,OAAO,CAAC,0BAA0B,CAE7C,CAAC;QACF,OAAO,GAAG,MAAA,GAAG,aAAH,GAAG,uBAAH,GAAG,CAAE,mBAAmB,mCAAI,IAAI,CAAC;IAC7C,CAAC;IAAC,WAAM,CAAC;QACP,OAAO,GAAG,IAAI,CAAC;IACjB,CAAC;IACD,OAAO,OAAO,CAAC;AACjB,CAAC","sourcesContent":["import type * as React from 'react';\n\ntype NavigationContainerComponent = React.ComponentType<Record<string, unknown>>;\n\nlet _cached: NavigationContainerComponent | null | undefined;\n\n/**\n * @returns NavigationContainer from @react-navigation/native or null if not installed.\n * The result is cached after the first call.\n */\nexport function getNavigationContainerComponent(): NavigationContainerComponent | null {\n  if (_cached !== undefined) {\n    return _cached;\n  }\n  try {\n    // eslint-disable-next-line @typescript-eslint/no-var-requires\n    const mod = require('@react-navigation/native') as {\n      NavigationContainer?: NavigationContainerComponent;\n    };\n    _cached = mod?.NavigationContainer ?? null;\n  } catch {\n    _cached = null;\n  }\n  return _cached;\n}\n"]}