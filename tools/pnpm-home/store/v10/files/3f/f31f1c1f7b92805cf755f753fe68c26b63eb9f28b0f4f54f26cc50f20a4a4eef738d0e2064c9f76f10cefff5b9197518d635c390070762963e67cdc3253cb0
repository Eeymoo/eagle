{"version":3,"file":"component-annotation-transform.js","sources":["../../../src/webpack/component-annotation-transform.ts"],"sourcesContent":["// Webpack loader for component annotation transform\n// Based on unplugin v1.0.1 transform loader pattern\n\nexport default async function transform(\n  this: {\n    async: () => (err: Error | null, content?: string, sourceMap?: unknown) => void;\n    resourcePath: string;\n    query: {\n      transform?: (code: string, id: string) => Promise<{ code: string; map?: unknown } | null | undefined | string>;\n    };\n  },\n  source: string,\n  map: unknown,\n): Promise<void> {\n  const callback = this.async();\n  const { transform: transformFn } = this.query;\n\n  if (!transformFn) {\n    return callback(null, source, map);\n  }\n\n  try {\n    const id = this.resourcePath;\n    const result = await transformFn(source, id);\n\n    if (result == null) {\n      callback(null, source, map);\n    } else if (typeof result === 'string') {\n      callback(null, result, map);\n    } else {\n      callback(null, result.code, result.map || map);\n    }\n  } catch (error) {\n    if (error instanceof Error) {\n      callback(error);\n    } else {\n      callback(new Error(String(error)));\n    }\n  }\n}\n"],"names":[],"mappings":"AAGA,eAA8B,SAAA,CAQ5B,QACA,GAAA,EACe;AACf,EAAA,MAAM,QAAA,GAAW,KAAK,KAAA,EAAM;AAC5B,EAAA,MAAM,EAAE,SAAA,EAAW,WAAA,EAAY,GAAI,IAAA,CAAK,KAAA;AAExC,EAAA,IAAI,CAAC,WAAA,EAAa;AAChB,IAAA,OAAO,QAAA,CAAS,IAAA,EAAM,MAAA,EAAQ,GAAG,CAAA;AAAA,EACnC;AAEA,EAAA,IAAI;AACF,IAAA,MAAM,KAAK,IAAA,CAAK,YAAA;AAChB,IAAA,MAAM,MAAA,GAAS,MAAM,WAAA,CAAY,MAAA,EAAQ,EAAE,CAAA;AAE3C,IAAA,IAAI,UAAU,IAAA,EAAM;AAClB,MAAA,QAAA,CAAS,IAAA,EAAM,QAAQ,GAAG,CAAA;AAAA,IAC5B,CAAA,MAAA,IAAW,OAAO,MAAA,KAAW,QAAA,EAAU;AACrC,MAAA,QAAA,CAAS,IAAA,EAAM,QAAQ,GAAG,CAAA;AAAA,IAC5B,CAAA,MAAO;AACL,MAAA,QAAA,CAAS,IAAA,EAAM,MAAA,CAAO,IAAA,EAAM,MAAA,CAAO,OAAO,GAAG,CAAA;AAAA,IAC/C;AAAA,EACF,SAAS,KAAA,EAAO;AACd,IAAA,IAAI,iBAAiB,KAAA,EAAO;AAC1B,MAAA,QAAA,CAAS,KAAK,CAAA;AAAA,IAC